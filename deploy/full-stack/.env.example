# QA-015: lab defaults ship in docker-compose.yml so `docker compose up`
# just works. For any non-laptop deployment, copy this to .env and set
# real values — every credential below overrides its lab default.
HARKENIQ_PG_PASSWORD=change-me
HARKENIQ_KC_ADMIN_PASSWORD=change-me
HARKENIQ_SITE_TOKEN=change-me
HARKENIQ_LICENSE_FINGERPRINT=change-me
HARKENIQ_INTERNAL_API_KEY=change-me
# QA-019: paths INSIDE the CC container to a Console-issued .lic file and
# the license verify public key (mount them via a volume). When set, CC
# verifies the license at startup and uses its fingerprint for site
# registration; empty = lab passthrough.
HARKENIQ_CC_LICENSE_KEY_PATH=
HARKENIQ_CC_LICENSE_VERIFY_KEY_PATH=
