# Mock Redfish simulator for full-stack testing.
# Runs the HarkenIQ MockSimulator on port 9000.

FROM python:3.12-slim

WORKDIR /app

# Install the harkeniq package (includes mock simulator)
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .

EXPOSE 9000

# R6-P0 fix: the previous inline-python CMD was a SyntaxError (escaped
# newlines don't survive the JSON-array form) — the container exited on
# start. The CLI has a proper entry point; use it.
CMD ["harken", "mock", "start", "--device", "dell-r750", "--port", "9000", "--host", "0.0.0.0", "--no-auth"]
