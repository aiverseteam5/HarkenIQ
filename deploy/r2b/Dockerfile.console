# Multi-stage: build React UI, then Python service
FROM node:22-slim AS ui-build
WORKDIR /app
COPY console-ui/package.json console-ui/package-lock.json ./
RUN npm ci
COPY console-ui/ .
# Auth wiring (QA-002): the SPA bakes its OIDC config at build time. The
# defaults match the shipped full-stack compose (Keycloak on host :8180,
# platform realm, public PKCE client). Override per deployment.
ARG VITE_KEYCLOAK_URL=http://localhost:8180
ARG VITE_KEYCLOAK_REALM=harkeniq-platform
ARG VITE_OIDC_CLIENT_ID=harkeniq-console
ARG VITE_AUTH_DEV_MODE=false
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_AUTH_DEV_MODE=$VITE_AUTH_DEV_MODE
RUN npm run build

FROM python:3.12-slim
WORKDIR /app

# Install base harkeniq package
COPY pyproject.toml setup.cfg* ./
COPY src/ src/
RUN pip install --no-cache-dir -e .

# Install console service (alembic.ini + migrations included — QA-001)
COPY services/console/pyproject.toml services/console/
COPY services/console/alembic.ini services/console/
COPY services/console/src/ services/console/src/
RUN pip install --no-cache-dir -e services/console/

COPY deploy/full-stack/entrypoint-console.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy built UI
COPY --from=ui-build /app/dist /app/console-ui-dist

ENV HARKEN_CONSOLE_UI_DIST=/app/console-ui-dist
EXPOSE 8100
ENTRYPOINT ["/entrypoint.sh"]
